# =============================================================================
# Her Flight Radar — environment variables
# =============================================================================
# Copy this file to `.env` or `.env.local` (Next.js loads both; `.env.local`
# overrides `.env` and is the usual place for secrets on your machine).
#
# Vercel: Project → Settings → Environment Variables (add the same names).
# Never commit real passwords or API keys to git.
# =============================================================================

# No user login — anyone with the URL can use the app.

# -----------------------------------------------------------------------------
# OpenSky OAuth2 (optional — server only, never sent to browser)
# -----------------------------------------------------------------------------
# OpenSky uses OAuth2 client credentials; Bearer on /api/states/all.
# https://openskynetwork.github.io/opensky-api/rest.html#authentication
#
# Set on Vercel or in .env:
#   OPENSKY_CLIENT_ID=...
#   OPENSKY_CLIENT_SECRET=...
# Or place credentials.json in project root (see credentials.example.json; file is gitignored).
# Optional: OPENSKY_CREDENTIALS_PATH=absolute\path\to\file.json
#
# If unset, requests stay anonymous.

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Public / client-side (embedded in the browser bundle)
# -----------------------------------------------------------------------------
# Display name in the header ("For ___"). Defaults to Prisha if unset.
NEXT_PUBLIC_HER_NAME=Prisha

# Full name on first-open welcome screen.
NEXT_PUBLIC_HER_FULL_NAME=Prisha Wadhwa

# Birthday countdown (optional). ISO date with her birthday (year can be birth year).
# Example: 2000-06-15 — app shows days until next calendar occurrence.
NEXT_PUBLIC_BIRTHDAY_ISO=

# Default METAR station when no airport label clicked (ICAO, 4 letters).
# Mumbai Intl — matches Santa Cruz East area; override if you want another home METAR.
NEXT_PUBLIC_HOME_AIRPORT_ICAO=VABB

# Surface (non-METAR) weather: Open-Meteo via /api/weather/point — no API key. Shown only when "Track me" GPS is on (your live fix).

# Optional: override first globe view / OpenSky bbox (defaults ~Santa Cruz East).
# NEXT_PUBLIC_HOME_LAT=19.081
# NEXT_PUBLIC_HOME_LNG=72.851
# NEXT_PUBLIC_HOME_GLOBE_ALT=0.38

# Optional: mapbox satellite (sharp); if set, overrides basemap choice.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Globe basemap (NEXT_PUBLIC_* — baked at build time).
# Default (omit): Carto Voyager — OSM streets / place names when zoomed in (similar to airplanes.live OSM view).
# esri | satellite = Esri World Imagery (photo satellite).
# positron | light = Carto Positron (light gray, full labels).
# carto | streets | voyager = Carto Voyager (same as default; explicit).
# NEXT_PUBLIC_GLOBE_TILES=esri
#
# Map UI: app opens in Globe by default; use header Globe / 2D toggle. Choice is stored in sessionStorage (her-radar-map-surface).

# -----------------------------------------------------------------------------
# Reserved / future
